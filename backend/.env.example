# Optional. These are read from the process environment (via
# os.environ), not loaded from this file automatically -- there is no
# python-dotenv dependency here. Export them yourself, or use your
# process manager's env support, if you want to override the local
# defaults below.

# Directory documents are stored in while being processed.
# Default if unset: tmp/privacylens
PRIVACYLENS_UPLOAD_ROOT=tmp/privacylens

# Comma-separated list of allowed CORS origins (whitespace around each
# entry is trimmed, empty entries dropped). Must not contain "*" --
# this API sends allow_credentials=True, and a wildcard origin is not
# a safe pairing with credentialed requests.
# Default if unset: http://localhost:5173,http://127.0.0.1:5173
PRIVACYLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
